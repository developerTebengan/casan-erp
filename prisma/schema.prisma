// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  USER
  DEPARTMENT_HEAD
  FINANCE
  MANAGER
  DIRECTOR

  @@map("user_role")
}

model User {
  id        String    @id @default(uuid())
  name      String
  email     String
  password  String
  role      UserRole  @default(USER)
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  requests          Purchase[]     @relation("Requester")
  departmentHeadOf  Purchase[]     @relation("DepartmentHead")
  financeApproverOf Purchase[]     @relation("FinanceApprover")
  finalApproverOf   Purchase[]     @relation("FinalApprover")
  notifications     Notification[]

  @@unique([email], where: raw("\"deletedAt\" IS NULL"))
  @@map("users")
}

enum NotificationType {
  PR_WAITING
  PR_DECIDED

  @@map("notification_type")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  titleKey  String
  bodyKey   String
  params    Json
  href      String
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id])

  @@index([userId, readAt])
  @@map("notifications")
}

model Supplier {
  id        String     @id @default(uuid())
  name      String
  type      String     @default("GENERAL")
  phone     String?
  address   String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?
  purchases         Purchase[]
  purchaseItems     PurchaseItem[]
  productSuppliers  ProductSupplier[]
  settlements       PurchaseSupplierSettlement[]
  refundRequests    RefundRequest[]
  pettyCashBuys     PettyCashTransaction[]

  @@map("suppliers")
}

model ProductSupplier {
  productId  String
  supplierId String
  createdAt  DateTime @default(now())

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@id([productId, supplierId])
  @@index([supplierId])
  @@map("product_suppliers")
}

model Category {
  id        String    @id @default(uuid())
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  products  Product[]

  @@unique([name], where: raw("\"deletedAt\" IS NULL"))
  @@map("categories")
}

model Product {
  id           String        @id @default(uuid())
  code         String
  name         String
  categoryId   String
  unit         String        @default("PCS")
  stock        Int           @default(0)
  minimumStock Int           @default(0)
  price        Decimal       @default(0)
  imageUrl     String?
  status       ProductStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  category          Category           @relation(fields: [categoryId], references: [id])
  purchaseItems          PurchaseItem[]
  stockTransactions      StockTransaction[]
  pettyCashTransactions  PettyCashTransaction[]
  productSuppliers       ProductSupplier[]

  @@unique([code], where: raw("\"deletedAt\" IS NULL"))
  @@map("products")
}

enum ProductStatus {
  ACTIVE
  INACTIVE

  @@map("product_status")
}

enum StockTransactionType {
  IN
  OUT
  ADJUSTMENT

  @@map("stock_transaction_type")
}

enum StockTransactionSource {
  MANUAL
  PURCHASE
  SALES
  ADJUSTMENT
  PETTY_CASH

  @@map("stock_transaction_source")
}

model StockTransaction {
  id          String                 @id @default(uuid())
  productId   String
  type        StockTransactionType
  source      StockTransactionSource @default(MANUAL)
  referenceId String?
  qty         Int
  stockBefore Int
  stockAfter  Int
  unitPrice   Decimal?
  note        String?
  createdBy   String?
  createdAt   DateTime               @default(now())
  deletedAt   DateTime?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([createdAt])
  @@map("stock_transactions")
}

model Purchase {
  id                       String           @id @default(uuid())
  prNumber                 String
  supplierId               String?
  dateOfRequest            DateTime         @default(now())
  priority                 PurchasePriority @default(MEDIUM)
  requesterId              String
  dateRequired             DateTime
  decisionDeadline         DateTime
  department               String
  purpose                  String
  comments                 String?
  total                    Decimal          @default(0)
  tax                      Decimal          @default(0)
  shipping                 Decimal          @default(0)
  otherFees                Decimal          @default(0)
  actualTax                Decimal?
  actualShipping           Decimal?
  actualOtherFees          Decimal?
  departmentHeadStatus     ApprovalStatus   @default(PENDING)
  departmentHeadApprovedAt DateTime?
  financeStatus            ApprovalStatus   @default(PENDING)
  financeApprovedAt        DateTime?
  finalStatus              ApprovalStatus   @default(PENDING)
  finalApprovedAt          DateTime?
  approvalStatus           ApprovalStatus   @default(PENDING)
  rejectionReason          String?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt
  deletedAt                DateTime?

  supplier        Supplier?      @relation(fields: [supplierId], references: [id])
  requester       User           @relation("Requester", fields: [requesterId], references: [id])
  departmentHead  User?          @relation("DepartmentHead", fields: [departmentHeadId], references: [id])
  financeApprover User?          @relation("FinanceApprover", fields: [financeApproverId], references: [id])
  finalApprover   User?          @relation("FinalApprover", fields: [finalApproverId], references: [id])
  items           PurchaseItem[]
  settlements     PurchaseSupplierSettlement[]
  refundRequests  RefundRequest[]

  departmentHeadId  String?
  financeApproverId String?
  finalApproverId   String?

  @@unique([prNumber], where: raw("\"deletedAt\" IS NULL"))
  @@map("purchases")
}

enum PurchasePriority {
  LOW
  MEDIUM
  HIGH
  URGENT

  @@map("purchase_priority")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("approval_status")
}

model PurchaseItem {
  id         String  @id @default(uuid())
  purchaseId String
  productId  String
  supplierId String?
  qty        Int
  price      Decimal
  subtotal   Decimal
  notes      String?

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])
  supplier Supplier? @relation(fields: [supplierId], references: [id])

  @@index([supplierId])
  @@map("purchase_items")
}

enum PettyCashType {
  TOP_UP
  SPEND
  REFUND
  TRANSFER

  @@map("petty_cash_type")
}

enum SourceOfFund {
  CASH
  BANK_TRANSFER
  DIRECTOR
  REVENUE
  OTHER
  PR_LEFTOVER

  @@map("source_of_fund")
}

enum RefundRequestStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("refund_request_status")
}

enum RefundDestination {
  KAS_KECIL
  BANK

  @@map("refund_destination")
}

model PettyCashAccount {
  id        String   @id @default("default")
  balance   Decimal  @default(0)
  updatedAt DateTime @updatedAt

  @@map("petty_cash_accounts")
}

model PettyCashTransaction {
  id                  String         @id @default(uuid())
  type                PettyCashType
  amount              Decimal
  balanceAfter        Decimal
  expectedAmount      Decimal?
  paidAmount          Decimal?
  catalogUnitPrice    Decimal?
  actualUnitPrice     Decimal?
  qty                 Int?
  productId           String?
  supplierId          String?
  stockTransactionId  String?
  sourceOfFund        SourceOfFund?
  note                String?
  createdBy           String?
  createdAt           DateTime       @default(now())

  product  Product?  @relation(fields: [productId], references: [id])
  supplier Supplier? @relation(fields: [supplierId], references: [id])
  refundRequest RefundRequest?

  @@index([type])
  @@index([createdAt])
  @@map("petty_cash_transactions")
}

model PurchaseSupplierSettlement {
  id           String   @id @default(uuid())
  purchaseId   String
  supplierId   String?
  supplierKey  String
  actualGoods  Decimal
  tax          Decimal  @default(0)
  delivery     Decimal  @default(0)
  other        Decimal  @default(0)
  updatedAt    DateTime @updatedAt

  purchase Purchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  supplier Supplier? @relation(fields: [supplierId], references: [id])

  @@unique([purchaseId, supplierKey])
  @@map("purchase_supplier_settlements")
}

model RefundRequest {
  id                      String               @id @default(uuid())
  status                  RefundRequestStatus  @default(PENDING)
  destination             RefundDestination
  amount                  Decimal
  purchaseId              String
  supplierId              String?
  supplierKey             String
  pettyCashTransactionId  String?              @unique
  prTotal                 Decimal
  actualGoods             Decimal
  tax                     Decimal              @default(0)
  delivery                Decimal              @default(0)
  other                   Decimal              @default(0)
  bill                    Decimal
  rejectReason            String?
  createdBy               String?
  decidedBy               String?
  createdAt               DateTime             @default(now())
  decidedAt               DateTime?

  purchase             Purchase              @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  supplier             Supplier?             @relation(fields: [supplierId], references: [id])
  pettyCashTransaction PettyCashTransaction? @relation(fields: [pettyCashTransactionId], references: [id])

  @@unique([purchaseId, supplierKey], where: raw("status IN ('PENDING','APPROVED')"))
  @@index([status])
  @@index([createdAt])
  @@map("refund_requests")
}

model CompanySettings {
  id           String   @id @default("default")
  companyName  String
  email        String
  phone        String
  taxId        String
  address      String
  currency     String   @default("IDR")
  dateFormat   String   @default("DD/MM/YYYY")
  itemsPerPage Int      @default(10)
  updatedAt    DateTime @updatedAt

  @@map("company_settings")
}

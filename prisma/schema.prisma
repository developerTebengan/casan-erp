// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  USER
  DEPARTMENT_HEAD
  FINANCE
  MANAGER
  DIRECTOR

  @@map("user_role")
}

model User {
  id        String    @id @default(uuid())
  name      String
  email     String
  password  String
  role      UserRole  @default(USER)
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  requests          Purchase[] @relation("Requester")
  departmentHeadOf  Purchase[] @relation("DepartmentHead")
  financeApproverOf Purchase[] @relation("FinanceApprover")
  finalApproverOf   Purchase[] @relation("FinalApprover")

  @@unique([email], where: raw("\"deletedAt\" IS NULL"))
  @@map("users")
}

model Supplier {
  id        String     @id @default(uuid())
  name      String
  phone     String?
  address   String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  purchases Purchase[]

  @@map("suppliers")
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@map("categories")
}

model Product {
  id            String        @id @default(uuid())
  code          String        @unique
  name          String
  categoryId    String
  unit          String        @default("PCS")
  stock         Int           @default(0)
  minimumStock  Int           @default(0)
  purchasePrice Decimal       @default(0)
  sellingPrice  Decimal       @default(0)
  status        ProductStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  category          Category           @relation(fields: [categoryId], references: [id])
  purchaseItems     PurchaseItem[]
  stockTransactions StockTransaction[]

  @@map("products")
}

enum ProductStatus {
  ACTIVE
  INACTIVE

  @@map("product_status")
}

enum StockTransactionType {
  IN
  OUT
  ADJUSTMENT

  @@map("stock_transaction_type")
}

enum StockTransactionSource {
  MANUAL
  PURCHASE
  SALES
  ADJUSTMENT

  @@map("stock_transaction_source")
}

model StockTransaction {
  id          String                 @id @default(uuid())
  productId   String
  type        StockTransactionType
  source      StockTransactionSource @default(MANUAL)
  referenceId String?
  qty         Int
  stockBefore Int
  stockAfter  Int
  note        String?
  createdBy   String?
  createdAt   DateTime               @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([createdAt])
  @@map("stock_transactions")
}

model Purchase {
  id                       String           @id @default(uuid())
  prNumber                 String           @unique
  supplierId               String?
  dateOfRequest            DateTime         @default(now())
  priority                 PurchasePriority @default(MEDIUM)
  requesterId              String
  dateRequired             DateTime
  department               String
  purpose                  String
  comments                 String?
  total                    Decimal          @default(0)
  departmentHeadStatus     ApprovalStatus   @default(PENDING)
  departmentHeadApprovedAt DateTime?
  financeStatus            ApprovalStatus   @default(PENDING)
  financeApprovedAt        DateTime?
  finalStatus              ApprovalStatus   @default(PENDING)
  finalApprovedAt          DateTime?
  approvalStatus           ApprovalStatus   @default(PENDING)
  rejectionReason          String?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  supplier        Supplier?      @relation(fields: [supplierId], references: [id])
  requester       User           @relation("Requester", fields: [requesterId], references: [id])
  departmentHead  User?          @relation("DepartmentHead", fields: [departmentHeadId], references: [id])
  financeApprover User?          @relation("FinanceApprover", fields: [financeApproverId], references: [id])
  finalApprover   User?          @relation("FinalApprover", fields: [finalApproverId], references: [id])
  items           PurchaseItem[]

  departmentHeadId  String?
  financeApproverId String?
  finalApproverId   String?

  @@map("purchases")
}

enum PurchasePriority {
  LOW
  MEDIUM
  HIGH
  URGENT

  @@map("purchase_priority")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("approval_status")
}

model PurchaseItem {
  id         String  @id @default(uuid())
  purchaseId String
  productId  String
  qty        Int
  price      Decimal
  subtotal   Decimal
  notes      String?

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@map("purchase_items")
}
